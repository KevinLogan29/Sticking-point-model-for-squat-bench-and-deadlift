import pandas as pd
import matplotlib.pyplot as plt

# -------------------------------
# Load CSV correctly
# -------------------------------
file_path = "Speed_measurements _Squat.csv"  # Update to your squat CSV file
try:
    df = pd.read_csv(file_path, sep=",", quotechar='"')
except FileNotFoundError:
    print(f"Error: {file_path} not found. Please provide the correct CSV file for Squat.")
    exit()

print("Squat - Columns detected:", df.columns.tolist())

# Convert time to seconds if given in ms
if df["Time (ms)"].max() > 100:
    df["Time (s)"] = df["Time (ms)"] / 1000.0
else:
    df["Time (s)"] = df["Time (ms)"]

time = df["Time (s)"]
velocity = df["Velocity (m/s)"].values
distance = df["Distance (m)"].values

# -------------------------------
# Detect major sticking points
# -------------------------------
peak_velocity = velocity.max()
threshold = 0.7 * peak_velocity  # 30% drop rule

sticking_times = []
sticking_vels = []
sticking_heights = []
sticking_zones = []

total_lift_height = distance.max() - distance.min()

def classify_zone(height, total_height):
    """Classify sticking point zone based on normalized bar height for squat."""
    if total_height == 0:
        return "Unknown"
    norm = (height - distance.min()) / total_height
    if norm <= 0.25:
        return "Bottom of squat"
    elif norm <= 0.50:
        return "Quarter squat"
    elif norm <= 0.75:
        return "Half squat"
    else:
        return "Near lockout"

for i in range(1, len(velocity) - 1):
    if velocity[i] < velocity[i - 1] and velocity[i] < velocity[i + 1]:
        if velocity[i] <= threshold:  # Only flag significant dips
            sticking_times.append(time.iloc[i])
            sticking_vels.append(velocity[i])
            sticking_heights.append(distance[i])
            sticking_zones.append(classify_zone(distance[i], total_lift_height))

# -------------------------------
# Print sticking points
# -------------------------------
if sticking_times:
    print("\nSquat - Detected sticking points:")
    for t, v, h, z in zip(sticking_times, sticking_vels, sticking_heights, sticking_zones):
        print(f" Time = {t:.2f}s | Velocity = {v:.3f} m/s | "
              f"Bar Height = {h:.3f} m | Zone = {z}")
else:
    print("\nSquat - No major sticking points detected.")

# -------------------------------
# Plot all signals vs time
# -------------------------------
fig, axes = plt.subplots(5, 1, figsize=(12, 12), sharex=True)

# Velocity with sticking points
axes[0].plot(time, velocity, color="blue", label="Velocity")
axes[0].scatter(sticking_times, sticking_vels, color="red", s=60,
                label="Major Sticking Point", zorder=5)
axes[0].axhline(y=threshold, color="gray", linestyle="--", alpha=0.5,
                label="70% Peak Velocity")
axes[0].set_ylabel("Velocity (m/s)")
axes[0].set_title("Squat Bar Path Data with Sticking Points")
axes[0].legend()

# Acceleration
axes[1].plot(time, df["Acceleration (m/s^2)"], color="green")
axes[1].set_ylabel("Acceleration (m/s²)")

# Distance
axes[2].plot(time, distance, color="purple")
axes[2].set_ylabel("Distance (m)")

# Force
axes[3].plot(time, df["Force (newtons)"], color="red")
axes[3].set_ylabel("Force (N)")

# Work
axes[4].plot(time, df["Work (joules)"], color="orange")
axes[4].set_ylabel("Work (J)")
axes[4].set_xlabel("Time (s)")

plt.tight_layout()
plt.show()
